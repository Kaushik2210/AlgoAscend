{
  "name": "algoascend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "test:coverage": "node --disable-warning=ExperimentalWarning --experimental-strip-types --experimental-test-coverage --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "predev": "node scripts/prepare-editor.mjs",
    "prebuild": "node scripts/prepare-editor.mjs",
    "test:reference": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/reference/*.test.ts",
    "runner:build": "node runner/build.mjs",
    "runner:serve": "node --env-file-if-exists=.env.local runner/server.mjs",
    "runner:configure": "node runner/configure.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@monaco-editor/react": "latest",
    "@vercel/sandbox": "3.6.1",
    "geist": "latest",
    "lucide-react": "latest",
    "monaco-editor": "latest",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5.9"
  }
}
